<?xml version="1.0"?>
<!--
  COLMIBOT estacionario para Gazebo Harmonic (C-006).

  Modelo: colmibot_description (Víctor, VicManJ-cloud/colmibot_ws@985b6b8), sin cambios.
  Extensiones Gazebo: patrón de Mingyar (Mingyar2/colmibot_ws@0aed972, urdf/colmibot.urdf),
  reducido a JointStatePublisher y, opcionalmente, la cámara montada en los frames de Víctor.

  Sin DiffDrive, sin cmd_vel, sin odometría, sin TF desde Gazebo.

  Argumentos:
    use_meshes:=true|false  (de colmibot_description)
    use_camera:=false|true  cámara simulada y system Sensors
-->
<robot name="colmibot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="use_camera" default="false"/>

  <xacro:include filename="$(find colmibot_description)/urdf/colmibot.urdf.xacro"/>

  <!-- Única fuente de /joint_states: Gazebo (puenteado GZ->ROS) -->
  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
      <joint_name>wheel_left_joint</joint_name>
      <joint_name>wheel_right_joint</joint_name>
    </plugin>
  </gazebo>

  <xacro:if value="$(arg use_camera)">
    <!-- Bloque de sensor de Mingyar (C920: hfov 1.229 rad) en camera_link de Víctor.
         Gazebo mira hacia +X del link; los mensajes salen en camera_optical_frame.
         Tasa reducida de 30 a 15 Hz por render sin GPU por defecto en WSL (llvmpipe). -->
    <gazebo reference="camera_link">
      <sensor name="camera" type="camera">
        <always_on>true</always_on>
        <update_rate>15</update_rate>
        <topic>camera/image_raw</topic>
        <gz_frame_id>camera_optical_frame</gz_frame_id>
        <camera>
          <horizontal_fov>1.229</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>15.0</far>
          </clip>
        </camera>
      </sensor>
    </gazebo>
    <gazebo>
      <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
        <render_engine>ogre2</render_engine>
      </plugin>
    </gazebo>
  </xacro:if>

</robot>
