# RViz para COLMIBOT con locomoción en Gazebo (C-007). Igual que rviz/sim.rviz (adaptado de
# rviz/display.rviz de VicManJ-cloud/colmibot_ws@985b6b8, Víctor), con fixed frame odom y una
# vista Odometry de /odom (DiffDrive de Gazebo, vía colmibot_motion_bridge).
Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /RobotModel1
        - /TF1
        - /Odometry1
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.05
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Alpha: 1
      Description Source: Topic
      Description Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_description
      Visual Enabled: true
      Collision Enabled: false
      Value: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Marker Scale: 0.15
      Show Arrows: true
      Show Axes: true
      Show Names: false
      Value: true
    - Class: rviz_default_plugins/Odometry
      Name: Odometry
      Enabled: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /odom
      Keep: 50
      Position Tolerance: 0.01
      Angle Tolerance: 0.05
      Shape:
        Value: Arrow
        Color: 255; 25; 0
        Alpha: 1
        Shaft Length: 0.1
        Shaft Radius: 0.004
        Head Length: 0.02
        Head Radius: 0.01
      Covariance:
        Value: false
      Value: true
    - Class: rviz_default_plugins/Image
      Name: Camera
      Enabled: false
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /camera/image_raw
      Max Value: 1
      Min Value: 0
      Normalize Range: true
      Value: false
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: odom
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 0.7
      Focal Point:
        X: 0
        Y: 0
        Z: 0.05
      Pitch: 0.5
      Yaw: 0.8
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz)
    Saved: ~
Window Geometry:
  Height: 800
  Width: 1200
