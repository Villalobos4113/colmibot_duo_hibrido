<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>colmibot_gazebo</name>
  <version>0.1.0</version>
  <description>Bringup estacionario de un COLMIBOT en Gazebo Harmonic y RViz 2: spawn, /clock y /joint_states de Gazebo a ROS, cámara opcional. Sin DiffDrive, cmd_vel, joystick ni hardware. Patrones de Mingyar2/colmibot_ws@0aed972; ver README.md.</description>
  <maintainer email="pendiente@example.invalid">Equipo COLMIBOT DUO (mantenedor por confirmar)</maintainer>
  <license>TODO: licencia pendiente de decisión del equipo (ver README.md)</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>colmibot_description</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>xacro</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>ament_index_python</test_depend>
  <test_depend>python3-yaml</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
